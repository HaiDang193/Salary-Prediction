
# Project
PROJECT_NAME=diabetes-prediction
RANDOM_STATE=42

# Kaggle dataset
KAGGLE_DATASET_ID=owner/dataset-slug

# SQL Server - each member can customize locally
DB_HOST=localhost
DB_PORT=1433
DB_NAME=diabetes
DB_DRIVER=ODBC Driver 18 for SQL Server

# 1 = SQL Server Authentication
# 0 = Windows Authentication
DB_USE_SQL_AUTH=1

DB_USER=your_username
DB_PASSWORD=your_password

DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
